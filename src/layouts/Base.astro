---
import "../styles/tokens.css";
import "@fontsource-variable/alumni-sans/wght.css";
import "@fontsource/fira-sans/cyrillic-400.css";
import "@fontsource/fira-sans/latin-400.css";
import "@fontsource/fira-sans/cyrillic-500.css";
import "@fontsource/fira-sans/latin-500.css";
import "../styles/global.css";
import "../styles/site.css";
import displayFont from "@fontsource-variable/alumni-sans/files/alumni-sans-cyrillic-wght-normal.woff2?url";

interface Props { lang: string; title: string; description: string; canonical?: string; rec?: string; bodyRec?: string; }
const { lang, title, description, canonical, rec, bodyRec } = Astro.props;
---
<!doctype html>
<html lang={lang} data-rec={rec}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <style is:global>
      /* Floor 4: no horizontal scroll at any width (also in global.css; stated here for the layout). */
      html, body { overflow-x: clip; }
    </style>
  </head>
  <body id="top" data-rec={bodyRec}>
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main" data-rec="G-R001,M-R004"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
