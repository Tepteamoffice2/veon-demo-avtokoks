---
// Line icons drawn for the page (one set, stroke = currentColor). Decorative: the control carries the label.
interface Props { name: "phone" | "menu" | "close" | "mail"; }
const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M6.6 3.5h3l1.5 4.2-2.1 1.4a11 11 0 0 0 5.9 5.9l1.4-2.1 4.2 1.5v3c0 1-.8 1.8-1.8 1.8A15.9 15.9 0 0 1 4.8 5.3c0-1 .8-1.8 1.8-1.8Z" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "mail" && <path d="M3.5 6.5h17v11h-17zM3.5 6.5l8.5 6.5 8.5-6.5" />}
</svg>
